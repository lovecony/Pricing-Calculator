<!doctype html>
<html lang="en">
<meta charset="utf-8">
<title>Pricing Calculator</title>

<h1>Pricing Calculator</h1>
<p>List price: $100 · Unit cost: $60</p>

<label for="discount">Discount (%)</label>
<input id="discount" type="number" min="0" max="100" value="20"
       oninput="calculate()">
<p id="result" aria-live="polite"></p>

<script>
  function calculate() {
    const discount = document.getElementById('discount');
    const result = document.getElementById('result');

    if (discount.value === '' || !discount.validity.valid) {
      result.textContent = 'Enter a discount from 0 to 100%.';
      return;
    }

    const sellingPrice = 100 * (1 - Number(discount.value) / 100);
    const profit = sellingPrice - 60;
    result.textContent =
      `Selling price: $${sellingPrice.toFixed(2)} · Profit: $${profit.toFixed(2)}`;
  }

  calculate();
</script>
</html>
